और अब वहाँ बहुत शांति महसूस होती है।","h":19},{"id":8,"name":"सुनील जोशी","loc":"अहमदाबाद, भारत","ed":1,"d":"Sep 02, 2026","s":5,"t":"पैसों की कीमत वसूल","b":"हार्डकॉपी की क्वालिटी बहुत अच्छी है। प्रिंटिंग शानदार है और चित्र बहुत स्पष्ट हैं। साथ में ई-बुक और कोर्स फ्री मिलना इसे एक शानदार डील बनाता है।","h":45},{"id":9,"name":"कविता सिंह","loc":"चंडीगढ़, भारत","ed":0,"d":"Aug 28, 2026","s":5,"t":"सरल और स्पष्ट भाषा","b":"वास्तु की भाषा अक्सर बहुत कठिन होती है, लेकिन यह किताब बहुत ही सरल हिंदी में लिखी गई है। कोई भी इसे आसानी से समझ सकता है।","h":27},{"id":10,"name":"दिनेश राजपूत","loc":"भोपाल, भारत","ed":1,"d":"Aug 25, 2026","s":5,"t":"नक्शा पढ़ना आसान हो गया","b":"नया घर खरीदने से पहले मैंने इस किताब को पढ़ा। अब मैं सिर्फ नक्शा देखकर ही घर के वास्तु दोष पहचान लेता हूँ। बहुत ही प्रैक्टिकल जानकारी है।","h":31},{"id":11,"name":"अंजली मेहता","loc":"सूरत, भारत","ed":0,"d":"Aug 20, 2026","s":4,"t":"धन क्षेत्र के उपाय","b":"उत्तर दिशा (धन क्षेत्र) को सक्रिय करने के जो उपाय दिए गए हैं, वो बहुत ही आसान और व्यावहारिक हैं। मैंने उन्हें लागू किया है और अच्छे बदलाव देख रही हूँ।","h":38},{"id":12,"name":"मनोज तिवारी","loc":"वाराणसी, भारत","ed":1,"d":"Aug 15, 2026","s":5,"t":"कोई अंधविश्वास नहीं","b":"सबसे अच्छी बात यह है कि इस किताब में डराया नहीं गया है, बल्कि लॉजिक के साथ चीजें समझाई गई हैं। बिना तोड़-फोड़ के वास्तु सुधारना संभव है, यह बात मुझे बहुत अच्छी लगी।","h":55}];
      var REVIEWS_PER_PAGE = 6;
      var currentPage = 1;
      var currentSort = 'recent';

      function renderStars(count) {
        var s = '';
        for (var i = 0; i < count; i++) s += '★';
        return s;
      }

      function getSortedReviews() {
        var copy = ALL_REVIEWS.slice();
        if (currentSort === 'highest') {
          copy.sort(function(a, b) { return b.s - a.s; });
        }
        return copy;
      }

      function renderPage(page) {
        currentPage = page;
        var data = getSortedReviews();
        var totalPages = Math.ceil(data.length / REVIEWS_PER_PAGE);
        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        var startIdx = (currentPage - 1) * REVIEWS_PER_PAGE;
        var endIdx = Math.min(startIdx + REVIEWS_PER_PAGE, data.length);
        var pageItems = data.slice(startIdx, endIdx);

        // Update count header
        var countEl = document.getElementById('bstrRevHeaderCount');
        if (countEl) {
          countEl.innerText = 'Showing ' + (startIdx + 1) + '–' + endIdx + ' of ' + data.length + ' Reviews';
        }

        // Render reviews HTML
        var container = document.getElementById('bstrReviewsContainer');
        if (container) {
          var html = '';
          pageItems.forEach(function(r) {
            var inits = r.name.split(' ').map(function(w){return w[0];}).join('');
            var edText = r.ed === 1 ? "Hardcopy + Softcopy + Video Course" : "Softcopy + Video Course";
            html += '<div class="bstr-rev-card">';
            html += '  <div class="bstr-rev-card-header">';
            html += '    <div class="bstr-rev-author-info">';
            html += '      <div class="bstr-rev-avatar">' + inits + '</div>';
            html += '      <div>';
            html += '        <div class="bstr-rev-author-name">';
            html += '          <span>' + r.name + '</span>';
            html += '          <span class="bstr-rev-verified-pill">';
            html += '            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            html += '            वेरीफाइड ख़रीदार';
            html += '          </span>';
            html += '        </div>';
            html += '        <div class="bstr-rev-meta">' + edText + ' · ' + r.loc + ' · ' + r.d + '</div>';
            html += '      </div>';
            html += '    </div>';
            html += '    <div class="bstr-rev-stars-item">' + renderStars(r.s) + '</div>';
            html += '  </div>';
            html += '  <div class="bstr-rev-title">"' + r.t + '"</div>';
            html += '  <div class="bstr-rev-body">' + r.b + '</div>';
            html += '  <div class="bstr-rev-card-footer">';
            html += '    <span>रिव्यू किया गया: ' + r.d + '</span>';
            html += '    <button type="button" class="bstr-rev-helpful-btn" onclick="this.innerHTML=\'✓ मददगार (' + (r.h + 1) + ')\'">👍 Helpful (' + r.h + ')</button>';
            html += '  </div>';
            html += '</div>';
          });
          container.innerHTML = html;
        }

        // Render Pagination
        renderPagination(totalPages);
      }

      function renderPagination(totalPages) {
        var pagEl = document.getElementById('bstrRevPagination');
        if (!pagEl) return;

        var html = '';
        
        // पीछे button
        html += '<button type="button" class="bstr-rev-page-btn" ' + (currentPage === 1 ? 'disabled' : '') + ' onclick="bstrGoToPage(' + (currentPage - 1) + ')">← Prev</button>';

        // Pages numbers (smart window)
        var maxButtons = 7;
        var startPage = Math.max(1, currentPage - 2);
        var endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) {
          startPage = Math.max(1, endPage - 4);
        }

        if (startPage > 1) {
          html += '<button type="button" class="bstr-rev-page-btn" onclick="bstrGoToPage(1)">1</button>';
          if (startPage > 2) html += '<span class="bstr-rev-dots">...</span>';
        }

        for (var p = startPage; p <= endPage; p++) {
          html += '<button type="button" class="bstr-rev-page-btn ' + (p === currentPage ? 'active' : '') + '" onclick="bstrGoToPage(' + p + ')">' + p + '</button>';
        }

        if (endPage < totalPages) {
          if (endPage < totalPages - 1) html += '<span class="bstr-rev-dots">...</span>';
          html += '<button type="button" class="bstr-rev-page-btn" onclick="bstrGoToPage(' + totalPages + ')">' + totalPages + '</button>';
        }

        // आगे button
        html += '<button type="button" class="bstr-rev-page-btn" ' + (currentPage === totalPages ? 'disabled' : '') + ' onclick="bstrGoToPage(' + (currentPage + 1) + ')">Next →</button>';

        pagEl.innerHTML = html;
      }

      window.bstrGoToPage = function(p) {
        renderPage(p);
        var comp = document.getElementById('bstr-reviews-component');
        if (comp) {
          var y = comp.getBoundingClientRect().top + window.pageYOffset - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      };

      window.bstrChangeSort = function(val) {
        currentSort = val;
        renderPage(1);
      };

      // Initial render
      renderPage(1);
    })();
  </script>
</div>
